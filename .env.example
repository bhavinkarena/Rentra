# Validated at boot by lib/validation/joi/env.js — the app fails fast if a
# required value is missing, rather than 500ing on the first request.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentra
REDIS_URL=redis://localhost:6379

# Razorpay sandbox only. Generic/live names are never used by gateway settings.
# The key ID must begin with rzp_test_. Keep all values on the server.
# Configure a separate webhook secret in Razorpay's TEST dashboard.
# Admin enablement permits Part 11 services; hosted customer checkout is Part 12.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
# Retain old TEST keys for existing attempts: {"rzp_test_OLD":{"keySecret":"..."}}
RAZORPAY_TEST_KEYRING_JSON={}
# Retain older TEST webhook secrets during provider retries, up to 10 entries.
RAZORPAY_TEST_PREVIOUS_WEBHOOK_SECRETS=[]

# Durable booking notifications stay in-app when SMS is disabled/unconfigured.
# Set twilio only after messaging setup; reuses server-side TWILIO_* credentials.
CUSTOMER_NOTIFICATION_DELIVERY=disabled
# Additional explicit opt-in before any Test/simulation booking can send SMS.
CUSTOMER_NOTIFICATION_ALLOW_TEST_SMS=false

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
# Public support link. Digits only, including country code; hidden when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Cloudinary — KYC document storage (authenticated type, signed delivery only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth: use a private random secret of at least 32 characters.
SESSION_SECRET=
DEV_OTP_BYPASS=false
# Unset CUSTOMER_OTP_DELIVERY defaults to development only in NODE_ENV=development/test:
# click Send code, then use 123456 (no SMS). Production/staging default to disabled.
# Set twilio when ready; never set development on a deployed production/staging app.
CUSTOMER_OTP_DELIVERY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Single-IP header overwritten by your trusted ingress (e.g. x-real-ip).
# Leave blank locally. Missing/invalid IPs share one conservative rate bucket.
CUSTOMER_AUTH_IP_HEADER=
